# Database
DATABASE_URL=postgresql://dashboard:SENHA@localhost:5432/dashboard

# Ingest auth — compartilhado com o N8N, adicionado como header X-Ingest-Secret
INGEST_SECRET=gere-com-openssl-rand-hex-32

# Digistore24 — SHA passphrase configurada no painel como "IPN password" (nomenclatura confusa, mas é isso)
DIGISTORE24_IPN_PASSPHRASE=passphrase-do-ipn-no-painel-digistore

# ClickBank API (Fase 2 — polling/reconciliação)
# Mesma chave pra read e write (a chave carrega os dois roles)
# Formato: API-<valor gerado no painel ClickBank>
CLICKBANK_API_KEY_READ=API-KEY-DE-LEITURA-DA-CLICKBANK
CLICKBANK_API_KEY_WRITE=API-KEY-DE-ESCRITA-DA-CLICKBANK
# Contas vendor às quais esta chave tem acesso (comma-separated nicknames)
# Ex: neurompro,burnthermo,maxvitaliz,glycopulse
CLICKBANK_VENDORS=vendor1,vendor2

# Job auth (Fase 2)
JOB_SECRET=gere-com-openssl-rand-hex-32

# Copy Optimizer — layer de fallback servido por /api/copy-decision quando o
# lead não cai em Black 2 (venda não encontrada, sem regra, ou bucket fora do %).
# Valores: 'black1' (default) | 'white' | 'black2'. O funnel-renderer reusa
# o INGEST_SECRET acima como X-Ingest-Secret pra chamar /api/copy-decision e
# /api/copy-view.
COPY_DEFAULT_LAYER=black1

# ============================================================
# Email (SMTP) — usado pra avisar partners de eventos:
#   - Network criada (welcome + credenciais + termos)
#   - Payout marcado como pago (confirmação)
#   - Termos do contrato alterados (re-aceite necessário)
#
# Fail-soft: se SMTP_PASS estiver vazio ou SMTP der erro, a operação
# continua normalmente (admin não é bloqueado). Email vira no-op com log.
#
# Pra Hostinger: SMTP_PASS é a senha que você definiu na hPanel quando
# criou a caixa de email. Reseta pelo painel se esquecer.
# ============================================================
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=usuario@exemplo.com
SMTP_PASS=                              senha-do-smtp
SMTP_FROM_EMAIL=no-reply@exemplo.com
SMTP_FROM_NAME=NorthScale

# Base URL pública do dashboard, usada nos links dos emails.
DASHBOARD_URL=https://dash.exemplo.com

# ============================================================
# Integração NorthScale Afiliados (contrato: integration-dashboard.md)
# Duas chaves, uma por sentido — podem também ser gravadas no banco pelo
# painel (Plataformas → Sistema de afiliados) via IntegrationSetting;
# a env var, quando presente, tem precedência.
#   INTEGRATION_API_KEY  chave que o DASHBOARD ENVIA no X-Api-Key ao ler
#                        GET {AFFILIATES_API_URL}/api/integrations/affiliates/mapping
#   DASHBOARD_API_KEY    chave que o dashboard ACEITA no X-Api-Key do
#                        POST /api/integrations/affiliates/webhook e do
#                        GET  /api/integrations/affiliates/metrics
# Sem DASHBOARD_API_KEY (env ou banco) os dois endpoints respondem 503.
# ============================================================
AFFILIATES_API_URL=https://api.afiliados.exemplo.com
INTEGRATION_API_KEY=
DASHBOARD_API_KEY=
# Reconciliação do mapping (pull): intervalo em minutos (padrão 1440 = diário,
# mínimo 5); AFFILIATES_SYNC_ENABLED=0 desliga o scheduler (endpoints seguem).
AFFILIATES_SYNC_INTERVAL_MIN=1440
AFFILIATES_SYNC_ENABLED=true

# SalesBound (cross-sell) — token do postback que eles chamam:
#   https://dash.thenorthscales.com/api/ingest/salesbound?token=<TOKEN>
# Pode ficar no banco (IntegrationSetting salesbound.postbackToken, via
# PUT /api/admin/integration-settings); a env, quando presente, vence.
SALESBOUND_POSTBACK_TOKEN=

# ============================================================
# Anthropic API — IA de análise no dashboard (/chat).
# Sem essa key, o endpoint /api/chat retorna 500 com mensagem
# clara. Resto do dashboard segue funcionando normalmente.
#
# Key obtida em https://console.anthropic.com/settings/keys
# Setar APENAS no .env do servidor — NÃO commitar valor real.
# ============================================================
ANTHROPIC_API_KEY=
