# Copie para .env e preencha. NUNCA coloque valor real neste arquivo — ele vai pro git.
# Explicação de cada variável: docs/configuracao.md

# ── Obrigatórias ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://dashboard:SENHA@localhost:5432/dashboard
# Chave de operação: header X-Ingest-Secret dos webhooks (n8n) e Bearer das rotas /api/admin/*.
# Gere com: openssl rand -hex 32. Nunca entregue a parceiros.
INGEST_SECRET=gere-com-openssl-rand-hex-32

# ── Produção (docker-compose) ──────────────────────────────────────────────
# POSTGRES_USER=dashboard
# POSTGRES_PASSWORD=gere-com-openssl-rand-hex-32
# POSTGRES_DB=dashboard
# Primeiro admin criado no boot (idempotente). Apague depois de criar.
# ADMIN_SEED_EMAIL=admin@exemplo.com
# ADMIN_SEED_PASSWORD=troque-esta-senha

# ── Plataformas ────────────────────────────────────────────────────────────
# Digistore24: o campo "IPN password" do painel é a SHA passphrase do IPN.
DIGISTORE24_IPN_PASSPHRASE=passphrase-do-ipn-no-painel-digistore
# ClickBank (API de leitura/reconciliação). Formato: API-<valor gerado no painel>.
CLICKBANK_API_KEY_READ=API-KEY-DE-LEITURA-DA-CLICKBANK
CLICKBANK_API_KEY_WRITE=API-KEY-DE-ESCRITA-DA-CLICKBANK
# Contas vendor que a chave enxerga, separadas por vírgula.
CLICKBANK_VENDORS=vendor1,vendor2

# ── Parceiros (também configuráveis pela tela; a env var tem precedência) ─
# Logicall (call center): o dash puxa as vendas pela API.
# LOGICALL_API_KEY=
# LOGICALL_API_BASE=https://api.logicall.io
# LOGICALL_COMMISSION_PCT=0.30
# Tauk (call center): comissão em fração.
# TAUK_COMMISSION_PCT=0.35
# SalesBound: token que eles mandam no postback.
SALESBOUND_POSTBACK_TOKEN=
# SendTrace (retenção): o dash puxa a cada 30 min.
# SENDTRACE_RETENTION_URL=
# SENDTRACE_RETENTION_KEY=

# ── NorthScale Afiliados (contrato: docs/integracoes/northscale-afiliados.md) ─
AFFILIATES_API_URL=https://api.afiliados.exemplo.com
# Chave que o DASHBOARD ENVIA ao ler o mapeamento deles.
INTEGRATION_API_KEY=
# Chave que o dashboard ACEITA no webhook e nas métricas (sem ela: 503).
DASHBOARD_API_KEY=
# Reconciliação do mapeamento: minutos (padrão 1440 = diário, mínimo 5). AFFILIATES_SYNC_ENABLED=0 desliga.
AFFILIATES_SYNC_INTERVAL_MIN=1440
AFFILIATES_SYNC_ENABLED=1

# ── Chat com IA ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Busca semântica da base de conhecimento (sem ela, só busca por texto).
# VOYAGE_API_KEY=
# CHAT_MODEL=claude-opus-5
# CLASSIFY_MODEL=claude-sonnet-5
# Ajustes finos (limites de anexo, histórico, contexto): docs/configuracao.md

# ── Outros ─────────────────────────────────────────────────────────────────
# URL pública do painel (links gerados pelo servidor).
DASHBOARD_URL=https://dash.exemplo.com
# Bearer do job de autotune do Copy Optimizer (cron externo).
JOB_SECRET=gere-com-openssl-rand-hex-32
# Layer servido pelo /api/copy-decision quando o lead não cai em Black 2: black1 | white | black2.
COPY_DEFAULT_LAYER=black1
# LOG_LEVEL=info
